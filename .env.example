# Public URL the app is reached at. REQUIRED: SvelteKit rejects form posts
# whose Origin header does not match it (CSRF protection).
# With Tailscale: https://manabudget.<your-tailnet>.ts.net
ORIGIN=http://localhost:3000

# Time zone used for "today" (recurring entries, default dates).
TZ=Europe/Paris

# Maximum request body size. adapter-node defaults to 512K, which breaks photo upload.
BODY_SIZE_LIMIT=25M

# Map tiles (Leaflet URL template).
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Nominatim instance used for address search (server-side proxy, 1 req/s, cached).
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Set to false to disable address search entirely.
GEOCODING_ENABLED=true

# User-Agent sent to Nominatim (their usage policy requires an identifying one).
# GEOCODER_USER_AGENT=ManaBudget/1.0 (you@example.com)

# Where the database and uploaded photos live (the container uses /data).
# DATA_DIR=./data

# Behind a reverse proxy (e.g. the Tailscale sidecar or `tailscale serve`), every request
# looks like it comes from 127.0.0.1, so the per-IP login rate limit would be shared by
# everyone. Tell the app which header carries the real client address:
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# HTTP port inside the container.
# PORT=3000
